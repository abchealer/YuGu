	int n, m,q;
const int N=1e6;
int arr[N];
int er(int k){
	int l=0,r=n-1;
	while(l<r){
		int mid=(l+r)/2;
		if(arr[mid]>=k) r=mid;
		else l=mid+1;
	}
	if(arr[l]==k)
	return l+1;
	else return -1;
}
int main() {
	cin>>n>>m;
	for(int i=0;i<n;i++) cin>>arr[i];
	while(m--){
		cin>>q;
		cout<<er(q)<<" ";
	} 
	return 0;
    
}
