#include <iostream>
#include <map>
using namespace std;
int main(){
	string h,d;
	map<char,int> q;
	int j=1;
	//1.得到<char,int>的map表 
	for(char i='A';i<='Z';i++){
		q[i]=j;
		j++;
	}
	int sum1=1, sum2=1;
	cin>>h>>d;
	//2.遍历字符串中的每一个字符，对应map中的int，求sum 
	for(int i=0;h[i];i++){
		sum1 *=q[h[i]];
	} 
	sum1=sum1%47;
	
	for(int i=0;d[i];i++){
		sum2 *=q[d[i]];
	} 
	sum2=sum2%47;
	if(sum1==sum2)
		cout<<"GO";
	else cout<<"STAY";
	return 0;
}
