/*暴力三层循环*/
#include <iostream>
#include <string>
#include<cstdio>
#include <math.h>>
using namespace std;

int main(){
	int n,m, k;
	cin>>n>>m>>k;
	int a[90]={0};
	int maxn=0;
	int b=0;
	for(int i=1;i<=n;i++){
		for(int j=1;j<=m;j++){
			for(int o=1;o<=k;o++){
				a[i+j+o]++;
				//cout<<i+j+o<<"-->"<<a[i+j+o]<<endl;
				maxn=max(maxn,a[i+j+o]);//求哪个和的"最大次数“ 
				
			}
		}
	}
	for(int i=0;i<90;i++){
		if(maxn==a[i]){
			cout<<i;//求最大次数对应的"和" 
			break;
		}
	}

	return 0; 
} 
